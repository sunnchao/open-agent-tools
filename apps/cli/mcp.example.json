{
  "mcpServers": [
    {
      "name": "open-agent-tools-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": ["tsx", "apps/mcp-server/src/index.ts"],
      "env": {},
      "trust": "confirm",
      "requirePermission": false,
      "allowedTools": null,
      "deniedTools": null,
      "token": null
    },
    {
      "name": "remote-mcp",
      "transport": "http",
      "url": "http://localhost:3000/mcp",
      "trust": "trusted",
      "requirePermission": true,
      "token": "your-bearer-token"
    }
  ]
}
