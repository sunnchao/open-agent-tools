{
  "name": "@open-agent-tools/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "prebuild": "pnpm -w run build:deps",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "pretypecheck": "pnpm -w run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "pnpm -w run build:deps",
    "test": "tsx --test --test-concurrency=1",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@open-agent-tools/database": "workspace:*",
    "@open-agent-tools/mcp-auth": "workspace:*",
    "@open-agent-tools/mcp-contracts": "workspace:*",
    "ajv": "^8.17.1",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/pg": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:"
  }
}
