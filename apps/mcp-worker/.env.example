REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_management

# Management API only. The background Worker does not listen on an HTTP port.
PORT=4200
# Optional browser origin allowed to call the management API (for example the
# Studio web build). Leave empty to disable cross-origin access.
# MCP_CORS_ORIGIN=http://127.0.0.1:8088

# Background Worker only. These are not required by dev:admin or start:admin.
TOOL_IMAGE_REPOSITORY=registry.example.com/mcp-tools
MCP_RUNNER_IMAGE=registry.example.com/mcp-nodejs-runner@sha256:replace-with-published-digest
NPM_NETWORK=mcp-npm-egress
# Optional, for Docker contexts that do not use the default socket (for example OrbStack).
# DOCKER_SOCKET_PATH=/absolute/path/to/docker.sock
# Set to false only when the local Buildx driver does not support attestations.
BUILDX_ATTESTATIONS=true
EXECUTION_CONCURRENCY=4
BUILD_CONCURRENCY=2

# Shared by the management API and background Worker.
ARTIFACT_S3_BUCKET=mcp-artifacts
ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Observability dashboard (management API only).
# Queue backlog thresholds for the health label in /api/admin/mcp/observability/overview.
OBSERVABILITY_QUEUE_BACKLOG_WARNING=20
OBSERVABILITY_QUEUE_BACKLOG_CRITICAL=100
# Alert loop collection interval in milliseconds.
OBSERVABILITY_ALERT_INTERVAL_MS=30000
