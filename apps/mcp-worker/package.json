{
  "name": "@open-agent-tools/mcp-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @open-agent-tools/mcp-contracts build && pnpm --filter @open-agent-tools/database build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "pretypecheck": "pnpm --filter @open-agent-tools/mcp-contracts build && pnpm --filter @open-agent-tools/database build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @open-agent-tools/mcp-contracts build && pnpm --filter @open-agent-tools/database build",
    "test": "tsx --test --test-concurrency=1",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-agent-tools/mcp-contracts": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "bullmq": "catalog:",
    "dockerode": "^4.0.7",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "yauzl": "^3.2.0",
    "@open-agent-tools/database": "workspace:*"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/pg": "catalog:",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "yazl": "^3.3.1"
  }
}
