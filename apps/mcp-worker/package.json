{
  "name": "@open-agent-tools/mcp-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm -w run build:deps",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:worker": "pnpm run dev",
    "dev:admin": "tsx watch src/control-plane/index.ts",
    "start": "node dist/index.js",
    "start:worker": "pnpm run start",
    "start:admin": "node dist/control-plane/index.js",
    "pretypecheck": "pnpm -w run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm -w run build:deps",
    "test": "tsx --test --test-concurrency=1",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@open-agent-tools/database": "workspace:*",
    "@open-agent-tools/mcp-auth": "workspace:*",
    "@open-agent-tools/mcp-contracts": "workspace:*",
    "@open-agent-tools/observability": "workspace:*",
    "bullmq": "catalog:",
    "dockerode": "^4.0.7",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "jose": "^6.1.0",
    "yauzl": "^3.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/express": "catalog:",
    "@types/pg": "catalog:",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "drizzle-kit": "^0.31.4",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "yazl": "^3.3.1"
  }
}
