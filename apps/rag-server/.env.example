# 环境变量（复制为 .env.local 或直接写入 .env）

# OpenAI 兼容网关（缺省时后端自动退化为 BM25 关键词检索，可离线演示）
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_MODEL=gpt-4o-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# RAG 服务端口（默认 4001，Studio Web 已代理 /rag-api）
# RAG_API_PORT=4001
# 本机默认只监听 127.0.0.1；容器部署确认只在私有网络暴露后再设 0.0.0.0。
# RAG_BIND_HOST=127.0.0.1
# 浏览器直连已改为 Agent Server BFF；仅确需跨域时才配置精确 Origin。
# RAG_CORS_ORIGIN=https://studio.example.com

# ---- 服务间鉴权（生产必填）----
# runtime: /api/query、/api/graph/retrieve、query feedback
# admin: 文档、图谱管理、评测；admin token 也可调用 runtime
# NODE_ENV=production 时缺少任一 token 会拒绝启动。
# RAG_RUNTIME_TOKEN=change-runtime-token
# RAG_ADMIN_TOKEN=change-admin-token

# 知识库 SQLite 路径（默认 apps/rag-server/rag.db；RAG_STORE=elasticsearch 时仅 analytics/eval 还用它）
# RAG_DB_PATH=../rag.db
# 存储后端：sqlite（默认，零运维）或 elasticsearch（需先起 ES，见 scripts/docker-compose.elasticsearch.yml）
# RAG_STORE=sqlite
# ES 节点与索引（仅 RAG_STORE=elasticsearch 时生效）
# RAG_ES_NODE=http://localhost:9200
# RAG_ES_INDEX_PREFIX=rag
# ES dense_vector 维度，须与 embedding 模型一致（text-embedding-3-small=1536；换模型先删索引重建）
# RAG_ES_DIMS=1536
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# 默认切分策略：fixed（结构/长度）或 semantic（需要 Embeddings）
# RAG_CHUNK_STRATEGY=fixed
# RAG_SEPARATORS=["\n\n","\n","。","！","？",". "," "]
# 语义切分相似度阈值（0-1，默认 0.75）：相邻语义单元低于阈值时断块，越高切得越细。
# RAG_SEMANTIC_THRESHOLD=0.75

# PDF OCR 兜底（P0 可诊断 + P1 本地占位）：默认关闭保持原生快路径。
# 开启后按“全文字符数/页数”检出疑似扫描件，文本层不足时走 OcrProvider 识别。
# RAG_OCR_ENABLED=false
# 每页平均字符数低于此值判定为疑似扫描（默认 50）。
# RAG_OCR_MIN_CHARS_PER_PAGE=50
# 同步入库允许的最大扫描页数，超限返回 413（等 P2 异步任务，默认 10）。
# RAG_OCR_MAX_PAGES_SYNC=10
# tesseract 语言与模型路径（P1 真机接入时使用，缺失时降级为诊断模式）。
# RAG_OCR_LANGS=chi_sim+eng
# RAG_TESSERACT_MODEL_PATH=../models

# 产品内查询日志保留天数（默认 90，服务启动时自动清理过期事件与反馈）
# RAG_QUERY_RETENTION_DAYS=90
# 图谱库 SQLite 路径（默认 apps/rag-server/rag-graph.db）
# 与 RAG_DB_PATH 同生命周期，切换环境时务必成对修改，否则新知识库会对着旧图谱做对账。
# RAG_GRAPH_DB_PATH=../rag-graph.db

# 上传后是否自动重建图谱（默认 true；设为 false 时来源只登记 pending，需手动对账）
# RAG_AUTO_EXTRACT=true

# Langfuse observability (tracing)。配置后自动启用；LANGFUSE_DISABLED=true 可强制关闭。
# 密钥在 Langfuse 项目的 Settings -> API Keys 创建。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com # EU；US 为 https://us.cloud.langfuse.com
# LANGFUSE_DISABLED=false
