# 环境变量（复制为 .env.local 或直接写入 .env）

# OpenAI 兼容网关（缺省时后端自动退化为 BM25 关键词检索，可离线演示）
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_MODEL=gpt-4o-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# RAG 服务端口（默认 4001，Studio Web 已代理 /rag-api）
# RAG_API_PORT=4001

# 知识库 SQLite 路径（默认 apps/rag-server/rag.db）
# RAG_DB_PATH=../rag.db
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
