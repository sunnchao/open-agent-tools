{
  "name": "@open-agent-tools/rag-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test server/*.test.ts",
    "test:e2e": "node scripts/e2e-lifecycle.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/openai": "catalog:",
    "@langfuse/core": "catalog:",
    "@langfuse/langchain": "^5.10.0",
    "@open-agent-tools/observability": "workspace:*",
    "@open-agent-tools/rag": "workspace:*",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
