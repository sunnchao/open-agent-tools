# 模型 Provider 不再从环境变量注入，统一在 Studio Web「设置」页面中添加与配置。
# 32-byte key encoded as 64 hex characters. Required before storing Provider keys,
# IM credentials, and Schema source connection strings.
CONFIG_SECRETS_ENCRYPTION_KEY=
# Legacy alias, kept for existing deployments:
# PROVIDER_KEYS_ENCRYPTION_KEY=
PORT=3000
WEB_ORIGIN=http://localhost:5173
# ---- Studio 部署访问 Token（主服务最小鉴权）----
# 配置后，所有 /api/* 接口必须携带 `Authorization: Bearer <token>`；
# /health 与 /v1/*（工作流对外 API，走各自的 workflow API Key）不受影响。
# 留空则保持本地开发体验（不鉴权）——仅供本机使用，对外部署必须配置。
# Studio Web 端可在「设置 → 部署访问 Token」中填写，或构建时注入 VITE_STUDIO_API_TOKEN。
# STUDIO_API_TOKEN=change-me-in-production
# ---- 企业身份（OIDC / LDAP 网关）MVP ----
# OIDC bearer JWT：OIDC_ISSUER、OIDC_AUDIENCE、OIDC_JWKS_URI 必须同时配置。
# 仅接受 RS256 / ES256；jose 验证 issuer、audience、exp/nbf，拒绝 alg=none。
# roles 命中 OIDC_ADMIN_ROLES 的用户才能访问 /api/admin/* 等 manage 接口；
# 普通成员仍可使用对话、会话等 run 接口。OIDC 启用后部署 token 仍可显式回退。
# OIDC_ISSUER=https://id.example.com
# OIDC_AUDIENCE=open-agent-tools-studio
# OIDC_JWKS_URI=https://id.example.com/.well-known/jwks.json
# OIDC_GROUPS_CLAIM=groups
# OIDC_ROLES_CLAIM=roles
# OIDC_ADMIN_ROLES=studio-admin,platform-admin
# OIDC_CLOCK_TOLERANCE_SECONDS=30
# OIDC_MAX_TOKEN_AGE_SECONDS=3600
#
# LDAP 不直连、不在请求中 bind：由企业可信网关完成 LDAP bind 与用户校验，
# 再签发下方 PUBLISHED_APP_ASSERTION_* HMAC viewer assertion。Agent Server
# 只配置网关入口用于 readiness 展示，绝不接收 LDAP 密码、bind DN 或 OIDC client secret。
# LDAP_TRUSTED_GATEWAY_URL=https://gateway.example.com/ldap/assert
# 调试模式：打开后输出各阶段耗时等 debug 级别日志（权限解析/生成SQL/执行SQL/摘要生成/LLM调用等），
# 且 trace.ts 的 truncate()/maskSecret() 不再截断或脱敏（会打印完整 SQL、Prompt、凭据等明文）。
# 仅限本地开发排查问题使用，生产环境不要打开。
# DEBUG=true
# OpenAPI 与访问点显示的公网基址；未配置时按当前请求 Host 推导。
# PUBLIC_API_BASE_URL=https://agent.example.com
# Optional exact HTTP workflow target hostnames; redirects are checked too.
# WORKFLOW_HTTP_ALLOWLIST=api.example.com,internal.example.com
# MCP Gateway 数据面。推荐在 Studio Web「设置 → MCP Gateway」中配置，Key 加密保存在 Agent Server。
# 以下环境变量仅在设置页没有保存配置时作为兜底。
# MCP_GATEWAY_URL=http://localhost:4100
# MCP_GATEWAY_API_KEY=mcp.xxx.xxx
# RAG Server 地址
# RAG_API_URL=http://localhost:4001/api
# ---- RAG 服务间鉴权 ----
# Agent Server 调 RAG 时使用的服务 token。RAG Server 配置后，runtime 只能查询，
# 文档、图谱管理、评测必须使用 admin token。生产环境下 RAG Server 缺少这两个 token 会拒绝启动。
# RAG_RUNTIME_TOKEN=change-runtime-token
# RAG_ADMIN_TOKEN=change-admin-token

# ---- 发布应用的签名身份断言 ----
# 企业网关从 SSO/LDAP 验证用户后签发的短期断言。浏览器绝不能持有 HMAC secret。
# optional: 无断言按公开文档；required_for_groups: 声明了 allowedGroups 的应用强制断言；
# required: 所有发布应用强制断言。
# PUBLISHED_APP_ASSERTION_HMAC_SECRET=openssl-rand-hex-32
# PUBLISHED_APP_ASSERTION_KEY_ID=gw-prod-2026-10
# PUBLISHED_APP_ASSERTION_ISSUER=corp-sso-gateway
# PUBLISHED_APP_ASSERTION_AUDIENCE=open-agent-tools-server
# PUBLISHED_APP_ASSERTION_MAX_SKEW_SECONDS=30
# PUBLISHED_APP_ASSERTION_MAX_AGE_SECONDS=60
# PUBLISHED_APP_IDENTITY_MODE=required_for_groups
# Optional absolute/relative path; default is apps/server/data/chat.sqlite
# SQLITE_PATH=

# ---- 飞书机器人（IM 协同）----
# 推荐在 Studio Web「设置 → IM 渠道」中可视化配置（多渠道、密钥加密存储、知识库绑定）。
# 以下环境变量仅在 im_channels 表为空时做一次"引导创建"，之后一律以表中配置为准。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_ENCRYPT_KEY=
# FEISHU_REQUIRE_MENTION=true
# RAG_SOURCES=
# RAG_TOP_K=5
# ---- 对话上下文预算（P0 压缩，零模型调用） ----
# 单轮输入硬上限（估算 tokens）：历史 + RAG + 工具定义共用，超限从旧往新裁。
#CHAT_INPUT_CAP=24000
# 给输出与工具回填的预留（记账用）。
#CHAT_RESERVE_OUTPUT=4000
# 无论如何保留的最近 user 轮数。
#CHAT_KEEP_RECENT_TURNS=20
# RAG 注入文本上限（字符），超限截断并在提示词中明示。
#CHAT_RAG_MAX_CHARS=8000
# 单个工具结果回填给模型的上限（字符）；DB 落库保持全文。
#CHAT_TOOL_RESULT_MAX_CHARS=6000
#
# ---- 长期记忆 ----
# 历史回读窗口：最近多少轮问答、最多多少字符（服务端以 DB 为准，不信任客户端全量重发）。
#CHAT_HISTORY_TURNS=20
#CHAT_HISTORY_MAX_CHARS=12000
# 事实抽取开关：off 关闭异步抽取（默认开启）。抽取失败只记 trace，不影响回复。
#MEMORY_EXTRACT=on

# Langfuse observability (tracing)。配置后自动启用；LANGFUSE_DISABLED=true 可强制关闭。
# 密钥在 Langfuse 项目的 Settings -> API Keys 创建。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com # EU；US 为 https://us.cloud.langfuse.com
# LANGFUSE_DISABLED=false

# ---- 报表数据查询（方案 C：Agent 侧直连）----
# 内置 query_sql 工具直连的 MySQL 只读连接串。建议用只读账号。
# 未配置时 query_sql 返回明确错误，聊天其余功能不受影响。
# chat 模块的 query_sql 仍可用于 NEW-API 运营库；AI 问数（/api/ai/query）必须指向 DTMS 只读库。
REPORT_DATABASE_URL=mysql://readonly:password@host:3306/dtms

# ---- Schema Observatory 数据源兼容入口 ----
# 推荐在 Studio Web「设置 → Schema 数据源」中配置多个来源。以下变量会作为只读、不可编辑的环境源显示。
# SCHEMA_SOURCE_URL=mysql://readonly:password@host:3306/oneapi
# PostgreSQL 示例：
# SCHEMA_SOURCE_CONNECTOR=postgresql
# SCHEMA_SOURCE_URL=postgresql://readonly:password@host:5432/analytics
# SCHEMA_SOURCE_SCHEMA=public
# SCHEMA_SOURCE_NAME=oneapi production
# SCHEMA_SOURCE_DATABASE=oneapi
# SCHEMA_SOURCE_TABLE_FILTER=users,logs,channels,orders
# SCHEMA_SOURCE_PROFILE=oneapi

# ---- AI 问数（POST /api/ai/query，SSE）----
# 问数专用 LLM provider id；缺省用默认 provider（Ollama 走 openai-chat 格式，baseUrl http://<host>:11434/v1，无需 API Key）
# AI_QUERY_PROVIDER_ID=
# 问数专用模型名；缺省用 provider 第一个模型
# AI_QUERY_MODEL=
# 追加敏感词（逗号分隔；命中即拦截，不调 LLM、不落库）
# AI_QUERY_SENSITIVE_WORDS=
# 决策层默认关闭；Gate A 可设 inherit/off/shadow/on。生产地址必须是内网服务。
# AI_QUERY_DECISION_MODE=off
# AI_QUERY_DECISION_GATE_A_MODE=inherit
# AI_QUERY_DECISION_BASE_URL=http://decision-service.internal
# AI_QUERY_DECISION_TIMEOUT_MS=400
# AI_QUERY_DECISION_CATALOG_VERSION=decision-catalog@v1
# 问数只允许 DTMS 白名单表（dtms_contract/invoice/payment/receipt/inventory/settlement），
# 禁止 NEW-API 运营库（logs/users/tokens/quota 等）。REPORT_DATABASE_URL 必须指向 DTMS 只读库。
# 中台 OAuth 基址（与 dtms-web apiUrl 一致）。配置后按 token 拉 getUserInfo/getSubSysList/getUserOrgList/menuTree。
# 未配置时走请求头兜底（仅本地）：X-AI-Industries、X-AI-Org-Nos、X-AI-Modules、Org-No、Sub-Sys-Id。
# DTMS_OAUTH_BASE_URL=http://localhost:9000
