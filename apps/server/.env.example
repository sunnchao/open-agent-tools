OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.wochirou.com/v1
OPENAI_API_MODEL=step-3.7-flash
# 32-byte key encoded as 64 hex characters. Required before storing Provider API keys.
PROVIDER_KEYS_ENCRYPTION_KEY=
PORT=3000
WEB_ORIGIN=http://localhost:5173
# MCP Gateway 数据面。API Key 仅保存在服务端，不发送给 Studio Web。
# MCP_GATEWAY_URL=http://localhost:4100
# MCP_GATEWAY_API_KEY=mcp.xxx.xxx
# RAG Server 地址
# RAG_API_URL=http://localhost:4001/api
# Optional absolute/relative path; default is apps/server/data/chat.sqlite
# SQLITE_PATH=
