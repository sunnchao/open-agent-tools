{
  "name": "@open-agent-tools/studio-app",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios --localhost",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "clean": "rm -rf dist .expo"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@open-agent-tools/workflow-contracts": "workspace:*",
    "@open-agent-tools/studio-client": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~53.0.0",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "@open-agent-tools/mcp-contracts": "workspace:*",
    "@open-agent-tools/api-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.72.8",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9"
  }
