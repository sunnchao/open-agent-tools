{
  "name": "open-agent-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run \"/^dev(:admin)?$/\"",
    "build": "pnpm --config.enable-pre-post-scripts=false -r --if-present run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build:deps && pnpm --config.enable-pre-post-scripts=false -r --if-present run test",
    "clean": "pnpm -r --if-present run clean",
    "typecheck": "pnpm run build:deps && pnpm --config.enable-pre-post-scripts=false -r --if-present run typecheck",
    "build:deps": "pnpm --filter \"./packages/*\" run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=10"
  }
}
