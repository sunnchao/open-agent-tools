# MCP Control Plane 管理面 (apps/mcp-worker, start:admin) —— 默认端口 4200
#
# 依赖 PostgreSQL + Redis + MinIO/S3(见 docker-compose.prod.yml)。
# 用法同 open-agent-server.service:替换 __REPO_ROOT__ / __USER__ 后安装。
[Unit]
Description=Open Agent Tools - MCP Control Plane (admin API)
Documentation=file://__REPO_ROOT__/docs/deploy/private-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=__REPO_ROOT__/apps/mcp-worker/.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# 需先执行:pnpm --filter @open-agent-tools/mcp-worker build
ExecStart=/usr/bin/env pnpm --filter @open-agent-tools/mcp-worker start:admin

Restart=on-failure
RestartSec=3

# ---- 最小加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
